{
  "manifest_version": 3,
  "name": "PSX Watch",
  "version": "1.0.0",
  "description": "Your personal Pakistan Stock Exchange watchlist.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PSX Watch"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://psxterminal.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac":     "Command+Shift+T"
      },
      "description": "Open PSX Watch"
    }
  }
}